<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verify Your New Email - Claundry</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #BAD6F5; font-family: 'DM Sans', Arial, sans-serif; display:flex; justify-items:center align-items:center;"
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      style="background-color: #BAD6F5; padding: 40px 20px;"
    >
      <tr>
        <td align="center">

          <!-- Main Card -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            style="max-width: 560px; background-color: #ffffff; border-radius: 20px; overflow: hidden;"
          >

            <!-- Header -->
            <tr>
              <td align="center" style="padding: 40px 40px 0 40px;">
                <img
                  src="{{logoUrl}}"
                  alt="Claundry"
                  height="36"
                  style="display: block; margin: 0 auto; border: 0;"
                />
              </td>
            </tr>

            <!-- Hero band -->
            <tr>
              <td style="padding: 32px 40px 0 40px;">
                <div
                  style="background-color: #BAD6F5; border-radius: 14px; padding: 32px; text-align: center;"
                >
                  <h1
                    style="margin: 0 0 8px 0; font-size: 28px; font-weight: 500; color: #004DE5; font-family: 'DM Sans', Arial, sans-serif; line-height: 1.2;"
                  >
                    Confirm your new email
                  </h1>
                  <p
                    style="margin: 0; font-size: 14px; color: #296FDA; font-family: 'DM Sans', Arial, sans-serif;"
                  >
                    One last step to update your email address.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 36px 40px 0 40px;">
                <p
                  style="margin: 0 0 8px 0; font-size: 22px; font-weight: 500; color: #1a1a1a; font-family: 'DM Sans', Arial, sans-serif;"
                >
                  Hi,
                  {{name}}
                  👋
                </p>
                <p
                  style="margin: 0 0 4px 0; font-size: 15px; color: #555555; line-height: 1.6; font-family: 'DM Sans', Arial, sans-serif;"
                >
                  You recently requested to change your email address
                </p>
                <p
                  style="margin: 0 0 20px 0; font-size: 15px; color: #555555; line-height: 1.6; font-family: 'DM Sans', Arial, sans-serif;"
                >
                  Click the button below to verify and activate your this new
                  email address.
                </p>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  style="margin-top: 24px; margin-bottom: 8px;"
                >
                  <tr>
                    <td align="center">
                      <a
                        href="{{verifyUrl}}"
                        style="display: inline-block; padding: 14px 32px; background-color: #296FDA; color: #ffffff; font-size: 14px; font-weight: 600; font-family: 'DM Sans', Arial, sans-serif; text-decoration: none; border-radius: 100px;"
                      >VERIFY NEW EMAIL</a>
                    </td>
                  </tr>
                </table>

                <!-- Warning -->
                <div
                  style="background-color: #FFF7ED; border-radius: 10px; padding: 16px 20px; margin-top: 24px; margin-bottom: 8px;"
                >
                  <p
                    style="margin: 0; font-size: 13px; color: #92400E; line-height: 1.6; font-family: 'DM Sans', Arial, sans-serif;"
                  >
                    <strong>Didn't request this?</strong>
                    You can safely ignore this email. Your email address will
                    not be changed.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 32px 40px 0 40px;">
                <div style="border-top: 1px solid #eeeeee;"></div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 28px 40px 36px 40px; text-align: center;">
                <p
                  style="margin: 0 0 4px 0; font-size: 12px; font-weight: 700; color: #1a1a1a; letter-spacing: 0.05em; font-family: 'DM Sans', Arial, sans-serif;"
                >
                  PT. CUCI KAIN ANGKASA
                </p>
                <p
                  style="margin: 0 0 16px 0; font-size: 11px; color: #999999; font-family: 'DM Sans', Arial, sans-serif;"
                >
                  Jl. Jendral Sudirman Kav. 52-53, SCBD, Jakarta Selatan, 12190
                </p>
                <p
                  style="margin: 0; font-size: 10px; color: #bbbbbb; font-family: 'DM Sans', Arial, sans-serif; line-height: 1.5;"
                >
                  © 2024 PT. CUCI KAIN ANGKASA. All rights reserved.<br />
                  You received this email because an email change was requested
                  for your Claundry account.
                </p>
              </td>
            </tr>

          </table>
          <!-- /Main Card -->

        </td>
      </tr>
    </table>
  </body>
</html>