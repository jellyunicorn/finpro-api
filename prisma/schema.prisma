generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int                    @id @default(autoincrement())
  email         String                 @unique
  password      String?
  birthDate     DateTime?              @map("birth_date")
  phone         String?
  role          Role                   @default(USER)
  avatar        String?
  fullName      String                 @map("full_name")
  provider      Provider               @default(CREDENTIALS)
  verifiedAt    DateTime?              @map("verified_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  deletedAt     DateTime?              @map("deleted_at")
  employee      Employee?
  address       UserAddress[]
  orders        Order[]
  complaints    Complaint[]
  refreshToken  RefreshToken?
  notifications NotificationsOnUsers[]

  @@map("users")
}

model Employee {
  id              Int             @id @default(autoincrement())
  type            EmployeeType
  salary          Int?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  user            User            @relation(fields: [userId], references: [id])
  userId          Int             @unique @map("user_id")
  outlet          Outlet          @relation(fields: [outletId], references: [id])
  outletId        Int             @map("outlet_id")
  attendance      Attendance[]
  orderJobs       OrderJob[]
  orderPickups    OrderPickup[]
  orderDeliveries OrderDelivery[]

  @@map("employees")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  startTime DateTime  @default(now()) @map("start_time")
  endTime   DateTime? @map("end_time")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int      @map("employee_id")

  @@map("attendances")
}

model UserAddress {
  id         Int       @id @default(autoincrement())
  address    String
  city       String
  label      String
  postalCode String    @map("postal_code")
  latitude   Decimal
  longitude  Decimal
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  regencyCode  String?   @map("regency_code")
  regency      Regency?  @relation(fields: [regencyCode], references: [code])
  districtCode String?   @map("district_code")
  district     District? @relation(fields: [districtCode], references: [code])
  villageCode  String?   @map("village_code")
  village      Village?  @relation(fields: [villageCode], references: [code])

  orders Order[]

  @@map("user_addresses")
}

model Outlet {
  id         Int       @id @default(autoincrement())
  name       String
  address    String
  city       String
  postalCode String    @map("postal_code")
  latitude   Decimal
  longitude  Decimal
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  employees Employee[]
  orders    Order[]
  orderJobs OrderJob[]

  @@map("outlets")
}

model Order {
  id              Int            @id @default(autoincrement())
  orderId         String         @unique @default(cuid()) @map("order_id")
  scheduledTime   DateTime       @map("scheduled_time")
  pickupTime      DateTime?      @map("pickup_time")
  orderStatus     OrderStatus    @map("order_status")
  deliveryCost    Int            @map("delivery_cost")
  paymentStatus   PaymentStatus  @map("payment_status")
  paymentMethod   PaymentMethod? @map("payment_method")
  paymentTime     DateTime?      @map("payment_time")
  distance        Decimal
  confirmedAt     DateTime?      @map("confirmed_at")
  deliveredAt     DateTime?      @map("delivered_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  xenditSessionId String?        @map("xendit_session_id")

  userId          Int             @map("user_id")
  user            User            @relation(fields: [userId], references: [id])
  outletId        Int             @map("outlet_id")
  outlet          Outlet          @relation(fields: [outletId], references: [id])
  addressId       Int?            @map("address_id")
  address         UserAddress?    @relation(fields: [addressId], references: [id])
  orderItems      OrderItem[]
  complaints      Complaint[]
  orderPickups    OrderPickup[]
  orderDeliveries OrderDelivery[]
  orderJobs       OrderJob[]

  @@map("orders")
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  name        String
  quantity    Int
  weight      Float     @default(0)
  price       Int
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  @@map("order_items")
}

model OrderJob {
  id             Int       @id @default(autoincrement())
  jobId          String    @unique @default(cuid()) @map("job_id")
  isBypassed     Boolean   @default(false) @map("is_bypassed")
  bypassApproved Boolean?  @map("bypass_approved")
  bypassedBy     String?
  station        Station
  startTime      DateTime  @default(now()) @map("start_time")
  endTime        DateTime? @map("end_time")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  employeeId Int?      @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])
  outletId   Int       @map("outlet_id")
  outlet     Outlet    @relation(fields: [outletId], references: [id])
  orderId    Int       @map("order_id")
  order      Order     @relation(fields: [orderId], references: [id])

  @@map("order_jobs")
}

model OrderPickup {
  id        Int          @id @default(autoincrement())
  pickupId  String       @unique @default(cuid()) @map("pickup_id")
  status    PickupStatus @default(WAITING_FOR_DRIVER)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  driverId Int?      @map("driver_id")
  driver   Employee? @relation(fields: [driverId], references: [id])
  orderId  Int       @map("order_id")
  order    Order     @relation(fields: [orderId], references: [id])

  @@map("order_pickups")
}

model OrderDelivery {
  id         Int            @id @default(autoincrement())
  deliveryId String         @unique @default(cuid()) @map("delivery_id")
  status     DeliveryStatus @default(WAITING_FOR_DRIVER)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  driverId Int?      @map("driver_id")
  driver   Employee? @relation(fields: [driverId], references: [id])
  orderId  Int       @map("order_id")
  order    Order     @relation(fields: [orderId], references: [id])

  @@map("order_deliveries")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  users NotificationsOnUsers[]

  @@map("notifications")
}

model NotificationsOnUsers {
  userId         Int          @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  notificationId Int          @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id])
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@id([userId, notificationId])
  @@map("user_notifications")
}

model Complaint {
  id            Int           @id @default(autoincrement())
  ticketNumber  Int           @unique @map("ticket_number")
  complaintType ComplaintType @map("complaint_type")
  body          String
  attachment    String?
  adminResponse String?       @map("admin_response")
  respondedBy   String?
  createdAt     DateTime      @default(now()) @map("created_at")

  customerId Int   @map("customer_id")
  customer   User  @relation(fields: [customerId], references: [id])
  orderId    Int   @map("order_id")
  order      Order @relation(fields: [orderId], references: [id])

  @@map("complaints")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Province {
  code      String    @id
  name      String
  regencies Regency[]

  @@map("provinces")
}

model Regency {
  code          String        @id
  name          String
  provinceCode  String        @map("province_code")
  province      Province      @relation(fields: [provinceCode], references: [code])
  districts     District[]
  userAddresses UserAddress[]

  @@map("regencies")
}

model District {
  code          String        @id
  name          String
  regencyCode   String        @map("regency_code")
  regency       Regency       @relation(fields: [regencyCode], references: [code])
  villages      Village[]
  userAddresses UserAddress[]

  @@map("districts")
}

model Village {
  code          String        @id
  name          String
  districtCode  String        @map("district_code")
  district      District      @relation(fields: [districtCode], references: [code])
  userAddresses UserAddress[]

  @@map("villages")
}

enum Role {
  USER
  ADMIN
  DRIVER
  WORKER
  SUPERADMIN
}

enum Provider {
  GOOGLE
  APPLE
  CREDENTIALS
}

enum EmployeeType {
  WORKER
  DRIVER
  ADMIN
}

enum OrderStatus {
  PENDING
  WAITING_FOR_DRIVER
  OTW_TO_OUTLET
  ARRIVED_AT_OUTLET
  WASHING
  IRONING
  PACKING
  WAITING_FOR_PAYMENT
  READY_TO_DELIVER
  OTW_TO_CUSTOMER
  ARRIVED_AT_CUSTOMER
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  VISA
  MASTERCARD
  CARDS
  GOPAY
  DANA
  XENDIT
  BCA_VIRTUAL_ACCOUNT
}

enum Station {
  WASHING
  IRONING
  PACKING
}

enum PickupStatus {
  PENDING
  WAITING_FOR_DRIVER
  OTW_TO_CUSTOMER
  OTW_TO_OUTLET
  ARRIVED_AT_OUTLET
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  WAITING_FOR_DRIVER
  OTW_TO_OUTLET
  OTW_TO_CUSTOMER
  ARRIVED_AT_CUSTOMER
  CANCELLED
}

enum ComplaintType {
  DAMAGED_CLOTHING
  DIRTY_CLOTHING
  TOOK_TOO_LONG
  DRIVER_WAS_RUDE
  OTHER
}

enum ComplaintStatus {
  PENDING
  RESOLVED
  EXPIRED
}
